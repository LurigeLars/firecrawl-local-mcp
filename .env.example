# Local self-hosted Firecrawl settings (read by docker compose via --env-file).
# No secrets live here. The API is unauthenticated, so it is bound to loopback only.
PORT=127.0.0.1:3002
USE_DB_AUTHENTICATION=false
NUM_WORKERS_PER_QUEUE=4
CRAWL_CONCURRENT_REQUESTS=6
MAX_CONCURRENT_JOBS=4
BROWSER_POOL_SIZE=4
LOGGING_LEVEL=INFO
# Local LLM for JSON/summary formats (Ollama on the host, loopback only)
OLLAMA_BASE_URL=http://llm-proxy:11435/api
MODEL_NAME=qwen2.5-16k
# Some Firecrawl code paths always use the OpenAI provider; point it at Ollama's OpenAI-compatible API (dummy key)
OPENAI_BASE_URL=http://llm-proxy:11435/v1
OPENAI_API_KEY=ollama-local-placeholder
# Prompt budget enforced by llm-proxy (Ollama keeps only num_ctx/2 input tokens; qwen2.5-16k -> ~8k)
LLM_MAX_INPUT_TOKENS=7000
# Cloudflare Access for the public MCP endpoint (identifiers, not secrets). ACCESS_AUD empty = not enforced yet.
ACCESS_TEAM_DOMAIN=<team>.cloudflareaccess.com
ACCESS_AUD=<Application Audience (AUD) tag from Cloudflare Access; empty = not enforced>
ACCESS_ALLOWED_EMAILS=<cloudflare-login-email>
# Emergency fallback only (secret link without Access): ACCESS_AUD= plus ALLOW_SECRET_PATH=1
ALLOW_SECRET_PATH=
# Search backend (SearXNG on the internal Docker network)
SEARXNG_ENDPOINT=http://searxng-proxy:8081
SEARXNG_CATEGORIES=general
