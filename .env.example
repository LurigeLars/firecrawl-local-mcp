# Example only. Copy to .env and keep the real file out of Git.
PORT=127.0.0.1:3002
USE_DB_AUTHENTICATION=false
NUM_WORKERS_PER_QUEUE=4
CRAWL_CONCURRENT_REQUESTS=6
MAX_CONCURRENT_JOBS=4
BROWSER_POOL_SIZE=4
LOGGING_LEVEL=INFO

# Local LLM.
OLLAMA_BASE_URL=http://llm-proxy:11435/api
MODEL_NAME=qwen2.5-16k
OPENAI_BASE_URL=http://llm-proxy:11435/v1
OPENAI_API_KEY=local-placeholder
LLM_MAX_INPUT_TOKENS=7000

# Public gateway / Access placeholders.
ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
ACCESS_AUD=replace-with-access-application-audience
ACCESS_ALLOWED_EMAILS=user@example.com
ALLOW_SECRET_PATH=

# Search backend.
SEARXNG_ENDPOINT=http://searxng-proxy:8081
SEARXNG_CATEGORIES=general
