+// Reject document MIME and magic before any native document parser or HTML
+// meta-refresh processing. This function does not parse the input document.
+fn check_html_only(fetched: &crate::fetch::FetchResult) -> Result<(), ScrapeError> {
+  let mime = fetched.mime();
+  if mime.as_deref() != Some("text/html") ||
+      crate::documents::sniff(&fetched.body, mime.as_deref(), &fetched.final_url).is_some() {
+    return Err(ScrapeError::new(415, "DOCUMENT_ISOLATION_REQUIRED", "Use the isolated PDF/document service."));
+  }
+  Ok(())
+}
