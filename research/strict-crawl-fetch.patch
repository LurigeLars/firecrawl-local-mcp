+fn validate_resolved(mut resolved: Vec<SocketAddr>, policy: NetworkPolicy) -> Result<Vec<SocketAddr>, Blocked> {
+  if policy == NetworkPolicy::PublicOnly {
+    for address in &resolved {
+      guard::check_ip(address.ip(), policy)?;
+    }
+  } else {
+    resolved.retain(|a| guard::check_ip(a.ip(), policy).is_ok());
+  }
+  if resolved.is_empty() {
+    return Err(Blocked("DNS returned no allowed address".into()));
+  }
+  Ok(resolved)
+}
