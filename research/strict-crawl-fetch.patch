+      }));
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let base = format!("http://{}", listener.local_addr().unwrap());
+    let server = tokio::spawn(async move { axum::serve(listener, app).await.unwrap(); });
+    let fetcher = Fetcher::new_no_redirect(NetworkPolicy::AllowPrivate).unwrap();
+    let opts = FetchOptions { timeout: Some(Duration::from_secs(2)), ..Default::default() };
+    let url = |path: &str| Url::parse(&format!("{base}/{path}")).unwrap();
+    assert_eq!(fetcher.fetch_once_limited(&url("ok"), &opts, 8).await.unwrap().body.len(), 8);
+    for path in ["large", "chunked"] {
+      assert!(matches!(fetcher.fetch_once_limited(&url(path), &opts, 8).await, Err(FetchError::TooLarge)));
+    }
+    assert!(matches!(fetcher.fetch_once_limited(&url("ok"), &opts, 0).await, Err(FetchError::TooLarge)));
+    server.abort();
+  }
