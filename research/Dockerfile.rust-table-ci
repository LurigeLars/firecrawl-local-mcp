# Research-only CI build; no production services or credentials.
FROM rust@sha256:1f65e0abcce9b449f9533df5994f2a62391059196c481a09b8e1b522dd6d75af AS prepared
WORKDIR /src
RUN git init && git fetch --depth 1 https://github.com/firecrawl/firecrawl.git 283bc7c662cf7b14801eb8b6f82b1b26533d8008 \
    && git checkout --detach FETCH_HEAD \
    && test "$(git rev-parse HEAD)" = 283bc7c662cf7b14801eb8b6f82b1b26533d8008
COPY nested-label-tables.patch job-store-lock.patch strict-crawl-fetch.patch document-isolation.patch /tmp/
COPY job-store /tmp/job-store
RUN git apply --check /tmp/nested-label-tables.patch /tmp/job-store-lock.patch /tmp/strict-crawl-fetch.patch /tmp/document-isolation.patch \
    && git apply /tmp/nested-label-tables.patch /tmp/job-store-lock.patch /tmp/strict-crawl-fetch.patch /tmp/document-isolation.patch
WORKDIR /src/apps/local
COPY table-fixture-probe.rs pdf-page-probe.rs local-search-probe.rs local-model-probe.rs local-render-probe.rs composed-api-test.rs candidate-api.rs candidate-batch.rs candidate-crawl.rs candidate-map.rs candidate-main.rs pdf-ocr-worker.rs pdf-ocr-service.rs candidate-pdf.rs pdf-result.rs /tmp/
RUN test "$(grep -c '^fn process_html(' src/scrape.rs)" = 1 \
    && sed -i 's/^fn process_html(/pub fn process_html(/' src/scrape.rs \
    && mkdir -p src/bin \
    && cp /tmp/table-fixture-probe.rs /tmp/pdf-page-probe.rs /tmp/local-search-probe.rs /tmp/local-model-probe.rs /tmp/local-render-probe.rs /tmp/composed-api-test.rs /tmp/candidate-main.rs /tmp/pdf-ocr-worker.rs /tmp/pdf-ocr-service.rs src/bin/ \
    && cp /tmp/candidate-api.rs /tmp/candidate-batch.rs /tmp/candidate-crawl.rs /tmp/candidate-map.rs /tmp/candidate-pdf.rs /tmp/pdf-result.rs src/ \
    && sed -i '/^\[dependencies\]$/a firecrawl-job-store-research = { path = "/tmp/job-store" }' Cargo.toml \
    && sed 's/use firecrawl_local::/use crate::/' /tmp/local-search-probe.rs > src/local-search-probe.rs \
    && sed 's/use firecrawl_local::/use crate::/' /tmp/local-render-probe.rs > src/local-render-probe.rs \
    && cp /tmp/local-model-probe.rs src/local-model-probe.rs \
    && printf '\n#[path = "candidate-api.rs"]\nmod candidate_api;\npub use candidate_api::run_candidate;\n' >> src/serve.rs
FROM prepared AS build
# Debug profile without debug symbols shares dependencies across tests and probe,
# avoiding the release profile's expensive fat LTO for a correctness-only job.
ENV CARGO_PROFILE_DEV_DEBUG=0 CARGO_PROFILE_TEST_DEBUG=0
RUN cargo test --locked --jobs 2 --lib markdown::tests \
    && cargo test --locked --jobs 2 --lib fetch::tests \
    && cargo test --locked --jobs 2 --lib guard::tests \
    && cargo test --locked --jobs 2 --bin local-search-probe --bin local-model-probe --bin local-render-probe --bin composed-api-test --bin pdf-ocr-worker --bin pdf-ocr-service \
    && cargo test --locked --jobs 2 --lib serve::candidate_api \
    && cargo build --locked --jobs 2 --bin table-fixture-probe --bin pdf-page-probe --bin candidate-main --bin pdf-ocr-worker --bin pdf-ocr-service
FROM debian@sha256:8aa5a7bf5a1955bddbe7d74fcdd0b91ab30e74362a8b73af672b0481b35b44a0 AS table-test
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libstdc++6 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /src/apps/local/target/debug/table-fixture-probe /usr/local/bin/table-fixture-probe
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/table-fixture-probe"]

# Runnable but isolated candidate; no production Compose/gateway configuration.
FROM table-test AS candidate-runtime
COPY --from=build /src/apps/local/target/debug/candidate-main /usr/local/bin/candidate-main
ENTRYPOINT ["/usr/local/bin/candidate-main"]

# Opt-in private OCR runtime; no Python fixture dependencies in this target.
FROM table-test AS ocr-runtime
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    poppler-utils tesseract-ocr tesseract-ocr-eng fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /src/apps/local/target/debug/pdf-ocr-worker /usr/local/bin/pdf-ocr-worker
COPY --from=build /src/apps/local/target/debug/pdf-ocr-service /usr/local/bin/pdf-ocr-service
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/pdf-ocr-service"]

# Disposable fixture stage only.
FROM ocr-runtime AS ocr-test
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pil python3-reportlab \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /src/apps/local/target/debug/pdf-page-probe /usr/local/bin/pdf-page-probe
COPY ocr-benchmark.py /research/ocr_benchmark.py
COPY verify-selective-ocr.py /research/verify-selective-ocr.py
COPY verify-ocr-service.py /research/verify-ocr-service.py
COPY --from=candidate-runtime /usr/local/bin/candidate-main /usr/local/bin/candidate-main
COPY verify-candidate-process.py /research/verify-candidate-process.py
USER 65532:65532
ENTRYPOINT ["python3","-B","/research/verify-selective-ocr.py"]

# Optional release measurement; no debug probe or Python in runtime image.
FROM prepared AS release-build
ENV CARGO_PROFILE_RELEASE_LTO=thin CARGO_PROFILE_RELEASE_CODEGEN_UNITS=8
RUN cargo build --locked --release --jobs 2 --bin candidate-main

FROM debian@sha256:8aa5a7bf5a1955bddbe7d74fcdd0b91ab30e74362a8b73af672b0481b35b44a0 AS release-runtime
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libstdc++6 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=release-build /src/apps/local/target/release/candidate-main /usr/local/bin/candidate-main
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/candidate-main"]

FROM release-runtime AS release-benchmark
USER root
RUN apt-get update && apt-get install -y --no-install-recommends python3 \
    && rm -rf /var/lib/apt/lists/*
COPY release-benchmark.py /research/release-benchmark.py
USER 65532:65532
ENTRYPOINT ["python3","-B","/research/release-benchmark.py"]
