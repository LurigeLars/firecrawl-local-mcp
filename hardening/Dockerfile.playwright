FROM node:22.23.2-trixie-slim

ENV PNPM_HOME="/pnpm"
ENV PATH="/pnpm:$PATH" \
    CI=true \
    COREPACK_ENABLE_PROJECT_SPEC=0 \
    PLAYWRIGHT_BROWSERS_PATH=/usr/local/share/playwright

RUN corepack enable && corepack prepare pnpm@11.11.0 --activate

WORKDIR /usr/src/app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm --pm-on-fail=ignore install --frozen-lockfile

COPY . .

RUN pnpm --pm-on-fail=ignore exec playwright install chromium --with-deps \
    && apt-get update \
    && apt-get -y upgrade \
    && rm -rf /var/lib/apt/lists/* \
    && pnpm --pm-on-fail=ignore run build \
    && pnpm --pm-on-fail=ignore prune --prod --ignore-scripts \
    && chown -R node:node /usr/src/app \
    && chmod -R a+rX /usr/local/share/playwright \
    && rm -rf \
        /usr/local/lib/node_modules/npm \
        /usr/local/lib/node_modules/corepack \
        /root/.cache/node/corepack \
        /pnpm \
    && rm -f \
        /usr/local/bin/npm \
        /usr/local/bin/npx \
        /usr/local/bin/corepack \
        /usr/local/bin/pnpm \
        /usr/local/bin/pnpx

ARG PORT
ENV PORT=${PORT}

EXPOSE ${PORT}

USER node

CMD ["node", "dist/api.js"]
