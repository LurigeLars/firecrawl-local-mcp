# Redis 8.10.3 remains the upstream application version.
# Patch the Alpine zlib package (CVE-2026-85091) in a minimal derived image.
# The build context is security/ only: never send local .env or upstream state.
FROM redis:8.10.3-alpine@sha256:21090af93f8324db2f0f0f4f38a7c60369d47d917e000c3423d89d2ae2883537
RUN apk upgrade --no-cache zlib \
    && apk info -v zlib | grep -qvFx 'zlib-1.3.2-r0'
